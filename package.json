{
  "name": "agent-observe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent 全链路观测台 — 只读直连 design-agent 共享 PostgreSQL，可视化 trace/span/执行/cost/audit。",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "tsx src/server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "db:create-role": "node scripts/create-readonly-role.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/static": "^8.3.0",
    "@tanstack/react-query": "^5.90.12",
    "dotenv": "^17.4.2",
    "fastify": "^5.6.2",
    "lucide-react": "^0.561.0",
    "pg": "^8.21.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router-dom": "^7.10.1"
  },
  "devDependencies": {
    "@types/node": "^25.0.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vitest": "^4.0.15"
  }
}
