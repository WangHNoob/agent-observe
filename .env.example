# agent-observe — Agent 全链路观测台
# 数据源：design-agent 共享 PostgreSQL，只读角色 obs_reader（scripts/create-readonly-role.sql 一次性创建）
# options 参数强制 default_transaction_read_only=on，双保险防写
OBS_DATABASE_URL=postgresql://obs_reader:obs_reader_dev@localhost:5433/game_designer?options=-c%20default_transaction_read_only%3Don
OBS_JWT_SECRET=change-me-to-a-long-random-string
OBS_ADMIN_PASSWORD=change-me

# 服务
PORT=4180
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5180

# 管理连接（obs_manager：删除/清理 + TTL 清理器）；不配置则管理功能禁用
OBS_MANAGER_DATABASE_URL=postgresql://obs_manager:obs_manager_dev@localhost:5433/game_designer
# trace 保留天数（TTL）：0 = 禁用自动清理
OBS_TRACE_RETENTION_DAYS=90
# 保留清理器间隔（毫秒），默认 1 小时
OBS_RETENTION_SWEEP_INTERVAL_MS=3600000

# schema 契约校验：严格模式（默认）发现共享库漂移直接启动失败；false = 仅告警
# 契约声明见根目录 schema-contract.json，变更需与 design-agent drizzle 迁移同步版本
OBS_SCHEMA_STRICT=true
# 指标聚合周期（毫秒），默认 1 小时（写入 obs_metrics.metric_hourly，需先执行
# node scripts/create-metrics-schema.mjs；未配置 OBS_MANAGER_DATABASE_URL 时自动禁用）
OBS_METRICS_INTERVAL_MS=3600000

# 告警引擎（需 obs_manager + obs_metrics.alerts 表；未配置 manager 时自动禁用）
# 评估周期（毫秒），默认 10 分钟
OBS_ALERT_INTERVAL_MS=600000
# webhook 通知（钉钉/飞书/企业微信）；不配置则仅站内记录
OBS_ALERT_WEBHOOK_URL=
# 规则阈值（可选，覆盖默认值）
OBS_ALERT_ERROR_RATE=0.2
OBS_ALERT_ERROR_MIN_TRACES=10
OBS_ALERT_TOKEN_THRESHOLD=400000
OBS_ALERT_COST_THRESHOLD_MICROS=5000000
OBS_ALERT_TIMEOUT_THRESHOLD=3
OBS_ALERT_HITL_STALL_HOURS=24

# 知识飞轮回流（观测信号 → knowledge-hub /api/mcp/query，需 obs_manager + 两表）
# knowledge-hub 基址与 service account JWT（经 knowledge-hub /api/auth/login 获取）；缺任一项回流禁用
OBS_FLYWHEEL_KH_URL=
OBS_FLYWHEEL_KH_TOKEN=
# 评估周期（毫秒），默认 10 分钟
OBS_FLYWHEEL_INTERVAL_MS=600000
# dry-run（默认 true）：只打印将上报的信号；灰度一周后设 false 开启真实上报
OBS_FLYWHEEL_DRY_RUN=true
# 目标项目（knowledge-hub 侧 projectId）
OBS_FLYWHEEL_PROJECT_ID=default_project
# 规则阈值
OBS_FLYWHEEL_ERROR_RATE=0.5
OBS_FLYWHEEL_MIN_ERRORS=3
OBS_FLYWHEEL_MIN_TIMEOUTS=3
OBS_FLYWHEEL_MIN_TOOL_ERRORS=3
OBS_FLYWHEEL_COST_THRESHOLD_MICROS=5000000
# 幂等窗口（小时），同信号窗口内不重复上报
OBS_FLYWHEEL_DEDUPE_HOURS=24
